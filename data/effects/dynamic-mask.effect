#include "base/shared.h.effect"
uniform texture2d InputB;
uniform float4   MaskBase;
uniform float4x4 MaskMatrix;
uniform float4   MaskMultiplier;

float4 DefaultPS(VertexInformation vtx) : TARGET
{
	// Sample both inputs at current UV.
	float4 imageA = InputA.Sample(PointClampSampler, vtx.uv0);
	float4 imageB = InputB.Sample(PointClampSampler, vtx.uv0);

	// Assign the base value as the mask.
	float4 mask = MaskBase;

	// MaskMatrix[0] contains all the "x Value from Red Input"
	mask += MaskMatrix[0] * imageB.r;

	// MaskMatrix[1] contains all the "x Value from Green Input"
	mask += MaskMatrix[1] * imageB.g;

	// MaskMatrix[2] contains all the "x Value from Blue Input"
	mask += MaskMatrix[2] * imageB.b;

	// MaskMatrix[3] contains all the "x Value from Alpha Input"
	mask += MaskMatrix[3] * imageB.a;

	// Multiply the mask value by the per channel multiplier.
	mask *= MaskMultiplier;

	// And finally multiply the input image with the mask.
	return imageA * mask;
}

technique Draw
{
	pass
	{
		vertex_shader = DefaultVS(vtx);
		pixel_shader = DefaultPS(vtx);
	}
}
