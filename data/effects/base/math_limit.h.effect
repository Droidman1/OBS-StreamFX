float wrap(float value, float low, float high) {
	float d = high - low;
	float t = value - low;
	float m = t / d;
	return value - (d * floor(m));
}

float2 wrap2(float2 value, float2 low, float2 high) {
	float2 d = high - low;
	float2 t = value - low;
	float2 m = t / d;
	return value - (d * floor(m));
}

float3 wrap3(float3 value, float3 low, float3 high) {
	float3 d = high - low;
	float3 t = value - low;
	float3 m = t / d;
	return value - (d * floor(m));
}

float4 wrap4(float4 value, float4 low, float4 high) {
	float4 d = high - low;
	float4 t = value - low;
	float4 m = t / d;
	return value - (d * floor(m));
}

float wrap_remainder(float value, float low, float high, out float remainder) {
	float d = high - low;
	float t = value - low;
	float m = t / d;
	remainder = floor(m);
	return value - (d * remainder);
}
float2 wrap2_remainder(float2 value, float low, float high, out float2 remainder) {
	float d = high - low;
	float2 t = value - low;
	float2 m = t / d;
	remainder = floor(m);
	return value - (d * remainder);
}
float3 wrap3_remainder(float3 value, float low, float high, out float3 remainder) {
	float d = high - low;
	float3 t = value - low;
	float3 m = t / d;
	remainder = floor(m);
	return value - (d * remainder);
}
float4 wrap4_remainder(float4 value, float low, float high, out float4 remainder) {
	float d = high - low;
	float4 t = value - low;
	float4 m = t / d;
	remainder = floor(m);
	return value - (d * remainder);
}

// Remap a value from [from_min]..[from_max] to [to_min]..[to_max].
float remap(float v, float from_min, float from_max, float to_min, float to_max) {
	return to_min + ((v - from_min) / (from_max - from_min)) * (to_max - to_min);
}

float2 remap2(float2 v, float2 from_min, float2 from_max, float2 to_min, float2 to_max) {
	return float2(
		remap(v.x, from_min.x, from_max.x, to_min.x, to_max.x),
		remap(v.y, from_min.y, from_max.y, to_min.y, to_max.y),
	);
}

float3 remap3(float3 v, float3 from_min, float3 from_max, float3 to_min, float3 to_max) {
	return float3(
		remap(v.x, from_min.x, from_max.x, to_min.x, to_max.x),
		remap(v.y, from_min.y, from_max.y, to_min.y, to_max.y),
		remap(v.z, from_min.z, from_max.z, to_min.z, to_max.z),
	);
}

float4 remap4(float4 v, float4 from_min, float4 from_max, float4 to_min, float4 to_max) {
	return float4(
		remap(v.x, from_min.x, from_max.x, to_min.x, to_max.x),
		remap(v.y, from_min.y, from_max.y, to_min.y, to_max.y),
		remap(v.z, from_min.z, from_max.z, to_min.z, to_max.z),
		remap(v.w, from_min.w, from_max.w, to_min.w, to_max.w),
	);
}
