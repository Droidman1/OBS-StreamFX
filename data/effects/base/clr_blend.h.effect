//------------------------------------------------------------------------------
// Add
//------------------------------------------------------------------------------
float blend_add(float a, float b) {
	return a + b;
}
float2 blend2_add(float2 a, float2 b) {
	return a + b;
}
float3 blend3_add(float3 a, float3 b) {
	return a + b;
}
float4 blend4_add(float4 a, float4 b) {
	return a + b;
}

//------------------------------------------------------------------------------
// Subtract
//------------------------------------------------------------------------------
float blend_sub(float a, float b) {
	return a - b;
}
float2 blend2_sub(float2 a, float2 b) {
	return a - b;
}
float3 blend3_sub(float3 a, float3 b) {
	return a - b;
}
float4 blend4_sub(float4 a, float4 b) {
	return a - b;
}

//------------------------------------------------------------------------------
// Average
//------------------------------------------------------------------------------
float blend_average(float a, float b) {
	return (a + b) * .5;
}
float2 blend2_average(float2 a, float2 b) {
	return (a + b) * .5;
}
float3 blend3_average(float3 a, float3 b) {
	return (a + b) * .5;
}
float4 blend4_average(float4 a, float4 b) {
	return (a + b) * .5;
}

//------------------------------------------------------------------------------
// Multiply
//------------------------------------------------------------------------------
float blend_mul(float a, float b) {
	return a * b;
}
float2 blend2_mul(float2 a, float2 b) {
	return a * b;
}
float3 blend3_mul(float3 a, float3 b) {
	return a * b;
}
float4 blend4_mul(float4 a, float4 b) {
	return a * b;
}

//------------------------------------------------------------------------------
// Divide
//------------------------------------------------------------------------------
float blend_div(float a, float b) {
	return a / b;
}
float2 blend2_div(float2 a, float2 b) {
	return a / b;
}
float3 blend3_div(float3 a, float3 b) {
	return a / b;
}
float4 blend4_div(float4 a, float4 b) {
	return a / b;
}

//------------------------------------------------------------------------------
// Screen
//------------------------------------------------------------------------------
float blend_screen(float a, float b) {
	return (1 - ((1. - a) * (1. - b)));
}
float2 blend2_screen(float2 a, float2 b) {
	return (1 - ((1. - a) * (1. - b)));
}
float3 blend3_screen(float3 a, float3 b) {
	return (1 - ((1. - a) * (1. - b)));
}
float4 blend4_screen(float4 a, float4 b) {
	return (1 - ((1. - a) * (1. - b)));
}
